# Copy to .env for local dev, or set these in Netlify → Site settings → Environment variables.
# Both are safe to expose to the browser (the anon key is protected by row-level security).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-side only (used by the Netlify function for the AI Import tab). NOT a VITE_ var.
# Set this in Netlify, never commit it.
# ANTHROPIC_API_KEY=sk-ant-...
